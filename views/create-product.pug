doctype html
html
  head
    title User Registration
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
  body
    .container.mt-5
      h1.mb-4 Create Product
      form( action='/products/create', method='POST')
        .mb-3
          input(type="hidden" name="_csrf" value=csrfToken)
          label.form-label(for='name') Name
          input.form-control(type='text', name='name', id='name', required=true)
        .mb-3
          label.form-label(for='weight') Weight
          input.form-control(type='text', name='weight', id='weight', required=true)
        .mb-3
          label.form-label(for='unit') Unit
          input.form-control(type='text', name='unit', id='unit', required=true)
        .mb-3
          label.form-label(for='quantity') Quantity
          input.form-control(type='number', name='quantity', id='quantity', required=true)
        .mb-3
          label.form-label(for='price') Price
          input.form-control(type='number', name='price', id='price', required=true)

        button.btn.btn-primary(type='submit') Create
  

