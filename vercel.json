{
    "version" : 2,
    "builds" : [
        {
            "src" : "/api/app.js",
            "use" : "@vercel/node"
        }
    ],
    "routes" : [
        {
            "src" : "/(.*)",
            "dest" : "/api/app.js"
        }
    ],
    "functions": {
        "api/**.js": {
        "runtime": "nodejs18.x"
        }
    }
}